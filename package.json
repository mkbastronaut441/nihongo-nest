{
  "name": "nihongo-nest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint src scripts",
    "format": "prettier --write src content public scripts next.config.ts eslint.config.mjs postcss.config.mjs vitest.config.ts package.json tsconfig.json .prettierrc.json README.md",
    "format:check": "prettier --check src content public scripts next.config.ts eslint.config.mjs postcss.config.mjs vitest.config.ts package.json tsconfig.json .prettierrc.json README.md",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node scripts/seed-kana.mjs",
    "db:seed:phase3": "node scripts/seed-phase3.mjs",
    "content:generate:phase3": "node scripts/generate-phase3-content.mjs",
    "content:import:kanjivg": "node scripts/import-kanjivg-strokes.mjs",
    "db:format": "prisma format",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "@next-auth/prisma-adapter": "^1.0.7",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.468.0",
    "next": "^15.5.4",
    "next-auth": "^4.24.11",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "prettier": "^3.6.2",
    "prisma": "^6.16.3",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
